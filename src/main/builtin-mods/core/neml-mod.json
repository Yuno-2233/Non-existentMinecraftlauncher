{
  "id": "core",
  "version": "1.0.0",
  "description": "引擎核心命令",
  "mainClass": "io.github.yuno2233.neml.core.CoreMainInit",
  "depends": {},
  "entrypoints": {
    "main": ["io.github.yuno2233.neml.core.CoreMainInit"],
    "command": ["io.github.yuno2233.neml.core.CoreCommandDispatcher"]
  },
