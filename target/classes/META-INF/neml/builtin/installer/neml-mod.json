{
  "id": "installer",
  "version": "1.0.0",
  "description": "下载安装 Minecraft 原版客户端",
  "mainClass": "io.github.yuno2233.neml.installer.InstallerMain",
  "depends": {},
  "entrypoints": {
    "main": ["io.github.yuno2233.neml.installer.InstallerMain"],
    "command": ["io.github.yuno2233.neml.installer.InstallerCommandDispatcher"]
  },
  "commands": {
    "install": {
      "description": "安装指定 Minecraft 版本",
      "usage": "neml installer install <版本ID> [自定义名称]",
      "args": [
        {"name": "版本ID", "description": "Minecraft 版本号", "optional": false},
        {"name": "自定义名称", "description": "本地存储名称", "optional": true}
      ]
    }
  }
}